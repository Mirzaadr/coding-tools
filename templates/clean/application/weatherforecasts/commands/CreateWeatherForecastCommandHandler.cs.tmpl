using MediatR;
using {{ .Name }}.Application.WeatherForecasts.DTOs;
using {{ .Name }}.Application.WeatherForecasts.Mappings;
using {{ .Name }}.Domain.Interfaces;

namespace {{ .Name }}.Application.WeatherForecasts.Commands;

public class CreateWeatherForecastCommandHandler : IRequestHandler<CreateWeatherForecastCommand, WeatherForecastDto>
{
    private readonly IWeatherForecastRepository _repository;

    public CreateWeatherForecastCommandHandler(IWeatherForecastRepository repository)
    {
        _repository = repository;
    }

    public async Task<WeatherForecastDto> Handle(CreateWeatherForecastCommand request, CancellationToken cancellationToken)
    {
        var entity = request.Dto.ToEntity();
        await _repository.AddAsync(entity, cancellationToken);
        await _repository.SaveChangesAsync(cancellationToken);
        return entity.ToDto();
    }
}